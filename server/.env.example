PORT=5000
NODE_ENV=development
# Leave MONGODB_URI empty only for development; production requires a reachable MongoDB URI.
MONGODB_URI=
# Generate a unique secret of at least 32 characters before starting the server.
JWT_SECRET=
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
