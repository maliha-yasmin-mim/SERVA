# SERVA Backend Environment Variables
PORT=5000
NODE_ENV=production

# Frontend Client URL(s) for CORS (comma-separated if multiple, *.vercel.app is automatically allowed)
CLIENT_URL=https://your-frontend-domain.vercel.app

# JWT Secret (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_encryption_key_at_least_32_chars_long

# Database - Supabase / PostgreSQL or MongoDB
MONGODB_URI=your_mongodb_connection_string
DATABASE_URL=postgresql://postgres:password@your-db.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
